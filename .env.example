# Copy this file to ".env.local" and fill in the values.

# TMDB key — get one free at https://www.themoviedb.org/settings/api
# Either the "API Key" (v3, short) or the "API Read Access Token" (v4, long) works.
# This stays on the server; it is never sent to visitors' browsers.
TMDB_API_KEY=

# Your site's public address (used for SEO: canonical links, sitemap, link previews).
# Leave as localhost while developing; change it when you deploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
